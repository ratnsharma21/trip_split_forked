# ==========================================
# Application Configuration
# ==========================================
PORT=3000
NODE_ENV=production

# ==========================================
# Database Configuration (PostgreSQL)
# ==========================================
# Database engine: "postgres" or "sqlite"
DB_TYPE=postgres

# PostgreSQL Connection Settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=tripsplit
DB_USER=tripsplit_user
DB_PASSWORD=tripsplit_secure_password

# PostgreSQL Container Root / Admin Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_root_password
POSTGRES_DB=tripsplit

# ==========================================
# Local SQLite Fallback Configuration
# ==========================================
DB_SQLITE_PATH=./data/tripsplit.sqlite
